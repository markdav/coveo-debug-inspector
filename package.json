{
  "name": "coveo-debug-inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Offline, client-side inspector for captured Coveo debug search responses.",
  "scripts": {
    "dev": "vite",
    "dev:extension": "vite --config vite.extension.config.ts",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -b && vite build --config vite.extension.config.ts",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonrepair": "^3.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
